{% comment %}
  Opt into cross-document (MPA) view transitions and hold first paint until #MainContent
  parses, so the transition runs consistently.
  Both are gated on the same settings as the view-transitions.js opt-out switch.
{% endcomment %}

{% if settings.transition_to_main_product or settings.page_transition_enabled %}
  {% style %}
    @media (prefers-reduced-motion: no-preference) {
      @view-transition {
        navigation: auto;
      }
    }
  {% endstyle %}

  <link
    rel="expect"
    href="#MainContent"
    blocking="render"
    id="view-transition-render-blocker"
  >
{% endif %}

{%- render 'meta-tags' -%}
{%- render 'stylesheets' -%}

{{ 'tv-banner.css' | asset_url | stylesheet_tag }}
{{ 'tv-product.grid.css' | asset_url | stylesheet_tag }}
{{ 'tv-product-modal.css' | asset_url | stylesheet_tag }}

{%- render 'fonts' -%}
{%- render 'scripts' -%}
{%- render 'theme-styles-variables' -%}
{%- render 'color-palette' -%}

{% if request.design_mode %}
  {%- render 'theme-editor' -%}
{% endif %}

{{ content_for_header }}

{% render 'chat-drawer' %}

<div class="page-wrapper">

  <main
    id="MainContent"
    class="content-for-layout"
    role="main"
    data-page-transition-enabled="{{ settings.page_transition_enabled }}"
    data-product-transition="{{ settings.transition_to_main_product }}"
    data-template="{{ template }}"
  >

    <div class="tv-page">

      {{ content_for_layout }}

      {% section 'tv-product-modal' %}

    </div>

  </main>

</div>

{% render 'cart-drawer', render_wrapper: true %}
{% render 'theme-drawer' %}
{% render 'search-modal' %}

{% if settings.quick_add or settings.mobile_quick_add %}
  {% render 'quick-add-modal' %}
{% endif %}

<script src="{{ 'tv-product.grid.js' | asset_url }}" defer></script>
<script src="{{ 'tv-product.modal.js' | asset_url }}" defer></script>
