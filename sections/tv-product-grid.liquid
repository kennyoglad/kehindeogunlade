<div style="
  display: block !important;
  width: 100% !important;
  min-height: 500px !important;
  padding: 50px !important;
  background: red !important;
  color: white !important;
  font-size: 40px !important;
  position: relative !important;
  z-index: 99999 !important;
">
  TV PRODUCT GRID IS RENDERING
</div>

<section class="tv-product-grid">
  <div class="tv-product-grid__inner">

    <h2 class="tv-product-grid__heading">
      Tisso vison in the wild
    </h2>

    <div class="tv-product-grid__items">

      {% for block in section.blocks %}
        <article
          class="tv-product-grid__item"
          {{ block.shopify_attributes }}
        >
          <div class="tv-product-grid__image-wrapper">

            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1000
                | image_tag:
                  class: 'tv-product-grid__image',
                  loading: 'lazy',
                  widths: '433, 650, 866, 1000',
                  sizes: '(min-width: 990px) 433px, (min-width: 750px) 50vw, 100vw'
              }}
            {% else %}
              <div class="tv-product-grid__placeholder">
                Product {{ forloop.index }}
              </div>
            {% endif %}

            {% if block.settings.product != blank %}
              <button
                type="button"
                class="tv-product-grid__hotspot"
                style="
                  --hotspot-x: {{ block.settings.hotspot_x }}%;
                  --hotspot-y: {{ block.settings.hotspot_y }}%;
                "
                aria-label="View {{ block.settings.product.title }}"
              >
                <span class="tv-product-grid__hotspot-circle">
                  <span class="tv-product-grid__hotspot-plus"></span>
                </span>
              </button>
            {% endif %}

          </div>
        </article>
      {% endfor %}

    </div>

  </div>
</section>

{% schema %}
{
  "name": "TV Product Grid",
  "tag": "section",
  "class": "section-tv-product-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "image_product",
      "name": "Product image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TV Product Grid",
      "blocks": [
        {
          "type": "image_product"
        },
        {
          "type": "image_product"
        },
        {
          "type": "image_product"
        },
        {
          "type": "image_product"
        },
        {
          "type": "image_product"
        },
        {
          "type": "image_product"
        }
      ]
    }
  ]
}
{% endschema %}
