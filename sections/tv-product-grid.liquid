<section
  class="tv-product-grid"
  id="tv-product-grid-{{ section.id }}"
>
  <div class="tv-product-grid__inner">

    {% if section.settings.heading != blank %}
      <h2 class="tv-product-grid__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="tv-product-grid__items">

      {% for block in section.blocks %}
        <article
          class="tv-product-grid__item"
          {{ block.shopify_attributes }}
        >

          <div class="tv-product-grid__image-wrapper">

            {% if block.settings.image != blank %}

              {{
                block.settings.image
                | image_url: width: 1000
                | image_tag:
                  class: 'tv-product-grid__image',
                  loading: 'lazy',
                  widths: '433, 650, 866, 1000',
                  sizes: '(min-width: 1440px) 433px, (min-width: 750px) 33.33vw, 100vw',
                  alt: block.settings.image.alt | default: 'Product image'
              }}

            {% else %}

              <div class="tv-product-grid__placeholder">
                <span>Select an image</span>
              </div>

            {% endif %}

            {% if block.settings.product != blank %}

              <button
                type="button"
                class="tv-product-grid__hotspot"
                style="
                  --hotspot-x: {{ block.settings.hotspot_x }}%;
                  --hotspot-y: {{ block.settings.hotspot_y }}%;
                "
                data-product-url="{{ block.settings.product.url }}"
                data-product-handle="{{ block.settings.product.handle }}"
                aria-label="View {{ block.settings.product.title }}"
              >
                <span class="tv-product-grid__hotspot-circle">
                  <span class="tv-product-grid__hotspot-plus"></span>
                </span>
              </button>

            {% endif %}

          </div>

        </article>
      {% endfor %}

    </div>

  </div>
</section>

{% schema %}
{
  "name": "TV Product Grid",
  "tag": "section",
  "class": "section-tv-product-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "image_product",
      "name": "Product image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "TV Product Grid",
      "blocks": [
        {
          "type": "image_product",
          "settings": {
            "hotspot_x": 59.2,
            "hotspot_y": 53.6
          }
        },
        {
          "type": "image_product",
          "settings": {
            "hotspot_x": 82.1,
            "hotspot_y": 50
          }
        },
        {
          "type": "image_product",
          "settings": {
            "hotspot_x": 60.3,
            "hotspot_y": 18.5
          }
        },
        {
          "type": "image_product",
          "settings": {
            "hotspot_x": 69.6,
            "hotspot_y": 16
          }
        },
        {
          "type": "image_product",
          "settings": {
            "hotspot_x": 49.1,
            "hotspot_y": 23.4
          }
        },
        {
          "type": "image_product",
          "settings": {
            "hotspot_x": 73.8,
            "hotspot_y": 36.9
          }
        }
      ]
    }
  ]
}
{% endschema %}
