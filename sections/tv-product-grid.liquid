<div
  style="
    display: block !important;
    width: 100% !important;
    min-height: 600px !important;
    padding: 60px !important;
    background: #ff0000 !important;
    color: #ffffff !important;
    font-size: 40px !important;
    line-height: 1.2 !important;
    position: relative !important;
    z-index: 999999 !important;
  "
>
  TV PRODUCT GRID IS HERE

  <div style="margin-top: 40px; font-size: 30px;">
    Section ID: {{ section.id }}
  </div>

  <div style="margin-top: 20px; font-size: 30px;">
    Blocks: {{ section.blocks.size }}
  </div>
</div>

{% schema %}
{
  "name": "TV Product Grid",
  "tag": "section",
  "class": "section-tv-product-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "image_product",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TV Product Grid",
      "blocks": [
        {
          "type": "image_product"
        },
        {
          "type": "image_product"
        },
        {
          "type": "image_product"
        },
        {
          "type": "image_product"
        },
        {
          "type": "image_product"
        },
        {
          "type": "image_product"
        }
      ]
    }
  ]
}
{% endschema %}


