tv-product-grid.liquid

<div class="tv-product-grid">

  {% if section.settings.heading != blank %}

    <h2 class="tv-product-grid__heading">
      {{ section.settings.heading }}
    </h2>

  {% endif %}

  <div class="tv-product-grid__items">

    {% for block in section.blocks %}

      <article
        class="tv-product-grid__item"
        {{ block.shopify_attributes }}
      >

        <div class="tv-product-grid__image-wrapper">

          {% if block.settings.image != blank %}

            {{
              block.settings.image
              | image_url: width: 866
              | image_tag:
                class: 'tv-product-grid__image',
                loading: 'lazy',
                widths: '433, 650, 866',
                sizes: '(min-width: 750px) 433px, 100vw'
            }}

          {% else %}

            <div class="tv-product-grid__placeholder">
              Add image
            </div>

          {% endif %}


          {% if block.settings.product != blank %}

            <button
              type="button"
              class="tv-product-grid__hotspot"
              style="
                --hotspot-x: {{ block.settings.hotspot_x }}%;
                --hotspot-y: {{ block.settings.hotspot_y }}%;
              "
              aria-label="View {{ block.settings.product.title | escape }}"
              data-product-url="{{ block.settings.product.url }}"
              data-product-handle="{{ block.settings.product.handle }}"
              data-product-id="{{ block.settings.product.id }}"
            >

              <span class="tv-product-grid__hotspot-circle">
                <span class="tv-product-grid__hotspot-plus"></span>
              </span>

            </button>

          {% endif %}

        </div>

      </article>

    {% endfor %}

  </div>

</div>


{% schema %}
{
  "name": "TV Product Grid",
  "tag": "section",
  "class": "tv-product-grid-section",

  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],

  "blocks": [
    {
      "type": "image_product",
      "name": "Product image",

      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "TV Product Grid",

      "blocks": [
        {
          "type": "image_product",
          "settings": {
            "hotspot_x": 59.2,
