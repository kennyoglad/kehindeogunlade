<section class="tv-product-grid-test">

  <h2>Tisso vison in the wild</h2>

  <div class="tv-product-grid-test__items">

    {% for block in section.blocks %}
      <div class="tv-product-grid-test__item" {{ block.shopify_attributes }}>
        <p>Product block {{ forloop.index }}</p>
      </div>
    {% endfor %}

  </div>

</section>

{% schema %}
{
  "name": "TV Product Grid",
  "settings": [],
  "blocks": [
    {
      "type": "product_image",
      "name": "Product"
    }
  ],
  "presets": [
    {
      "name": "TV Product Grid",
      "blocks": [
        {
          "type": "product_image"
        },
        {
          "type": "product_image"
        },
        {
          "type": "product_image"
        },
        {
          "type": "product_image"
        },
        {
          "type": "product_image"
        },
        {
          "type": "product_image"
        }
      ]
    }
  ]
}
{% endschema %}
