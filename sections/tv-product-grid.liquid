{{ 'tv-product.grid.css' | asset_url | stylesheet_tag }}
{{ 'tv-product.grid.js' | asset_url | script_tag }}

{% assign jacket_product = all_products['dark-winter-jacket'] %}

<script
  type="application/json"
  id="tv-soft-winter-jacket-variants"
>
  {% if jacket_product != blank %}
    {{ jacket_product.variants | json }}
  {% else %}
    []
  {% endif %}
</script>

{% assign jacket_product = all_products['dark-winter-jacket'] %}
{% assign jacket_variant_id = blank %}

{% if jacket_product != blank %}

  {% for jacket_variant in jacket_product.variants %}

    {% assign jacket_has_black = false %}
    {% assign jacket_has_medium = false %}

    {% for option_value in jacket_variant.options %}

      {% assign normalized_option = option_value | strip | downcase %}

      {% if normalized_option == 'black' %}
        {% assign jacket_has_black = true %}
      {% endif %}

      {% if normalized_option == 'medium' %}
        {% assign jacket_has_medium = true %}
      {% endif %}

    {% endfor %}

    {% if jacket_has_black and jacket_has_medium and jacket_variant.available %}
      {% assign jacket_variant_id = jacket_variant.id %}
      {% break %}
    {% endif %}

  {% endfor %}

{% endif %}

<script
  type="application/json"
  id="tv-soft-winter-jacket-config-{{ section.id }}"
>
  {
    "productFound": {% if jacket_product != blank %}true{% else %}false{% endif %},
    "variantId": {% if jacket_variant_id != blank %}{{ jacket_variant_id }}{% else %}null{% endif %}
  }
</script>

<section
  id="tv-product-grid-{{ section.id }}"
  class="tv-product-grid"
  data-section-id="{{ section.id }}"
>
  <div class="tv-product-grid__container">

    {% if section.settings.heading != blank %}
      <h2 class="tv-product-grid__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="tv-product-grid__items">

      {% for block in section.blocks %}
        {% assign product = block.settings.product %}

        {% if product != blank %}

          {% assign featured_image = product.featured_image %}

          <article
            class="tv-product-card"
            {{ block.shopify_attributes }}
            data-product-id="{{ product.id }}"
          >

            <div class="tv-product-card__image-wrapper">

              {% if featured_image != blank %}

                {{
                  featured_image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '375, 550, 750, 900, 1200',
                    sizes: '(min-width: 990px) 33vw, 100vw',
                    class: 'tv-product-card__image',
                    alt: featured_image.alt | default: product.title
                }}

              {% else %}

                <div class="tv-product-card__image-placeholder">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>

              {% endif %}

              {% comment %}
                Product hotspot.
                Position is controlled from the Theme Customizer.
              {% endcomment %}

              <button
                type="button"
                class="tv-product-hotspot"
                style="
                  --hotspot-x: {{ block.settings.hotspot_x }}%;
                  --hotspot-y: {{ block.settings.hotspot_y }}%;
                "
                aria-label="View {{ product.title | escape }}"
                aria-controls="tv-product-popup-{{ section.id }}-{{ block.id }}"
                aria-expanded="false"
              >
                <span class="tv-product-hotspot__circle">
                  <span class="tv-product-hotspot__plus"></span>
                </span>
              </button>

            </div>

          </article>


          {% comment %}
            PRODUCT POPUP
          {% endcomment %}

          <div
            id="tv-product-popup-{{ section.id }}-{{ block.id }}"
            class="tv-product-popup"
            aria-hidden="true"
            data-popup
          >

            <div
              class="tv-product-popup__overlay"
              data-popup-close
            ></div>

            <div
              class="tv-product-popup__content"
              role="dialog"
              aria-modal="true"
              aria-label="{{ product.title | escape }}"
            >

              <button
                type="button"
                class="tv-product-popup__close"
                data-popup-close
                aria-label="Close"
              >
                &times;
              </button>


              <div class="tv-product-popup__top">

                <div class="tv-product-popup__image">

                  {% if featured_image != blank %}

                    {{
                      featured_image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        class: 'tv-product-popup__image-element',
                        alt: featured_image.alt | default: product.title
                    }}

                  {% endif %}

                </div>


                <div class="tv-product-popup__details">

                  <h3 class="tv-product-popup__title">
                    {{ product.title }}
                  </h3>

                  <div class="tv-product-popup__price">

                    {% if product.compare_at_price > product.price %}

                      <span class="tv-product-popup__price-current">
                        {{ product.price | money }}
                      </span>

                      <span class="tv-product-popup__price-compare">
                        {{ product.compare_at_price | money }}
                      </span>

                    {% else %}

                      <span>
                        {{ product.price | money }}
                      </span>

                    {% endif %}

                  </div>

                  {% if product.description != blank %}

                    <div class="tv-product-popup__description">
                      {{ product.description | strip_html | truncate: 180 }}
                    </div>

                  {% endif %}

                </div>

              </div>


              {% if product.available %}

                <form class="tv-product-popup__form">

                 <script type="application/json" class="tv-product-popup__variants">
                  {{ product.variants | json }}
                </script>
              
                <script type="application/json" class="tv-product-popup__option-names">
                  {{ product.options | json }}
                </script>
                
                  {% for option in product.options_with_values %}
                
                    {% if option.name == 'Color' %}
                
                      <div class="tv-product-popup__option">

                        <label class="tv-product-popup__label">
                          {{ option.name }}
                        </label>
                      
                        <div class="tv-product-popup__colors">
                      
                          {% for value in option.values %}
                      
                            {% assign colour = value | strip | downcase %}
                            {% assign accent = "#DDDDDD" %}
                      
                            {% case colour %}
                              {% when 'white' %}
                                {% assign accent = "#FFFFFF" %}
                              {% when 'black' %}
                                {% assign accent = "#000000" %}
                              {% when 'blue' %}
                                {% assign accent = "#0D499F" %}
                              {% when 'red' %}
                                {% assign accent = "#B20F36" %}
                              {% when 'grey', 'gray' %}
                                {% assign accent = "#AFAFB7" %}
                              {% when 'green' %}
                                {% assign accent = "#4D8B31" %}
                              {% when 'brown' %}
                                {% assign accent = "#7A4A2E" %}
                              {% when 'orange' %}
                                {% assign accent = "#DD7A1D" %}
                              {% when 'beige' %}
                                {% assign accent = "#DCC7A1" %}
                              {% when 'pink' %}
                                {% assign accent = "#E6A5B8" %}
                              {% when 'yellow' %}
                                {% assign accent = "#E4C63C" %}
                            {% endcase %}
                      
                            <button
                              type="button"
                              class="tv-product-popup__color"
                              data-color="{{ value | escape }}"
                              style="--tv-color-accent: {{ accent }};"
                            >
                              {{ value }}
                            </button>
                      
                          {% endfor %}
                      
                        </div>
                      
                      </div>
                
                    {% endif %}
                
                  {% endfor %}
                
                
                  {%- comment -%}
                    ==========================================================
                    ALL OTHER OPTIONS — AFTER COLOR
                    ==========================================================
                  {%- endcomment -%}
                
                  {% for option in product.options_with_values %}
                
                    {% unless option.name == 'Color' %}
                      
                        <div class="tv-product-popup__option tv-product-popup__option--size">
                
                        <label class="tv-product-popup__label">
                          {{ option.name }}
                        </label>
                
                        <select
                          class="tv-product-popup__select"
                          data-option-name="{{ option.name }}"
                        >
                
                          <option value="">
                            Choose your {{ option.name | downcase }}
                          </option>
                
                          {% for value in option.values %}
                
                            <option value="{{ value }}">
                              {{ value }}
                            </option>
                
                          {% endfor %}
                
                        </select>
                
                      </div>
                
                    {% endunless %}
                
                  {% endfor %}
                
                
                  {%- comment -%}
                    ==========================================================
                    ADD TO CART
                    ==========================================================
                  {%- endcomment -%}
                
                  <button
                    type="button"
                    class="tv-product-popup__add"
                    data-product-id="{{ product.id }}"
                    data-product-handle="{{ product.handle }}"
                  >
                    <span>ADD TO CART</span>
                    <span class="tv-product-popup__arrow">→</span>
                  </button>
                
                </form>

              {% else %}

                <div class="tv-product-popup__sold-out">
                  SOLD OUT
                </div>

              {% endif %}

            </div>

          </div>

        {% endif %}

      {% endfor %}

    </div>

  </div>
</section>



{% schema %}
{
  "name": "TV Product Grid",
  "tag": "section",
  "class": "section-tv-product-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 60
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TV Product Grid",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}



