{{ 'tv-product.grid.css' | asset_url | stylesheet_tag }}

<section
  id="tv-product-grid-{{ section.id }}"
  class="tv-product-grid"
  data-section-id="{{ section.id }}"
>
  <div class="tv-product-grid__container">

    {% if section.settings.heading != blank %}
      <h2 class="tv-product-grid__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="tv-product-grid__items">

      {% for block in section.blocks %}
        {% assign product = block.settings.product %}

        {% if product != blank %}

          {% assign featured_image = product.featured_image %}

          <article
            class="tv-product-card"
            {{ block.shopify_attributes }}
            data-product-id="{{ product.id }}"
          >

            <div class="tv-product-card__image-wrapper">

              {% if featured_image != blank %}

                {{
                  featured_image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '375, 550, 750, 900, 1200',
                    sizes: '(min-width: 990px) 33vw, 100vw',
                    class: 'tv-product-card__image',
                    alt: featured_image.alt | default: product.title
                }}

              {% else %}

                <div class="tv-product-card__image-placeholder">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>

              {% endif %}

              {% comment %}
                Product hotspot.
                Position is controlled from the Theme Customizer.
              {% endcomment %}

              <button
                type="button"
                class="tv-product-hotspot"
                style="
                  --hotspot-x: {{ block.settings.hotspot_x }}%;
                  --hotspot-y: {{ block.settings.hotspot_y }}%;
                "
                aria-label="View {{ product.title | escape }}"
                aria-controls="tv-product-popup-{{ section.id }}-{{ block.id }}"
                aria-expanded="false"
              >
                <span class="tv-product-hotspot__circle">
                  <span class="tv-product-hotspot__plus"></span>
                </span>
              </button>

            </div>

          </article>


          {% comment %}
            PRODUCT POPUP
          {% endcomment %}

          <div
            id="tv-product-popup-{{ section.id }}-{{ block.id }}"
            class="tv-product-popup"
            aria-hidden="true"
            data-popup
          >

            <div
              class="tv-product-popup__overlay"
              data-popup-close
            ></div>

            <div
              class="tv-product-popup__content"
              role="dialog"
              aria-modal="true"
              aria-label="{{ product.title | escape }}"
            >

              <button
                type="button"
                class="tv-product-popup__close"
                data-popup-close
                aria-label="Close"
              >
                &times;
              </button>


              <div class="tv-product-popup__top">

                <div class="tv-product-popup__image">

                  {% if featured_image != blank %}

                    {{
                      featured_image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        class: 'tv-product-popup__image-element',
                        alt: featured_image.alt | default: product.title
                    }}

                  {% endif %}

                </div>


                <div class="tv-product-popup__details">

                  <h3 class="tv-product-popup__title">
                    {{ product.title }}
                  </h3>

                  <div class="tv-product-popup__price">

                    {% if product.compare_at_price > product.price %}

                      <span class="tv-product-popup__price-current">
                        {{ product.price | money }}
                      </span>

                      <span class="tv-product-popup__price-compare">
                        {{ product.compare_at_price | money }}
                      </span>

                    {% else %}

                      <span>
                        {{ product.price | money }}
                      </span>

                    {% endif %}

                  </div>

                  {% if product.description != blank %}

                    <div class="tv-product-popup__description">
                      {{ product.description | strip_html | truncate: 180 }}
                    </div>

                  {% endif %}

                </div>

              </div>


              {% if product.available %}

                <form class="tv-product-popup__form">

                 
                
                  {% for option in product.options_with_values %}
                
                    {% if option.name == 'Color' %}
                
                      <div class="tv-product-popup__option">
                
                        <label class="tv-product-popup__label">
                          {{ option.name }}
                        </label>
                
                        <div class="tv-product-popup__colors">
                
                          {% for value in option.values %}
                
                            <button
                              type="button"
                              class="tv-product-popup__color{% if forloop.first %} active{% endif %}"
                              data-option-name="{{ option.name }}"
                              data-option-value="{{ value }}"
                              style="
                              --color-strip:
                              {% case value | downcase %}
                                  {% when 'white' %}#FFFFFF
                                  {% when 'black' %}#000000
                                  {% when 'blue' %}#0D499F
                                  {% when 'red' %}#B20F36
                                  {% when 'grey' %}#AFAFB7
                                  {% when 'gray' %}#AFAFB7
                                  {% when 'green' %}#4D8B31
                                  {% when 'brown' %}#7A4A2E
                                  {% when 'beige' %}#DCC7A1
                                  {% when 'orange' %}#DD7A1D
                                  {% when 'pink' %}#E9A3B2
                                  {% when 'yellow' %}#E3C443
                                  {% else %}#DDDDDD
                              {% endcase %}
                              "
                          >
                              {{ value }}
                          </button>
                
                          {% endfor %}
                
                        </div>
                
                      </div>
                
                    {% endif %}
                
                  {% endfor %}
                
                
                  {%- comment -%}
                    ==========================================================
                    ALL OTHER OPTIONS — AFTER COLOR
                    ==========================================================
                  {%- endcomment -%}
                
                  {% for option in product.options_with_values %}
                
                    {% unless option.name == 'Color' %}
                
                      <div class="tv-product-popup__option">
                
                        <label class="tv-product-popup__label">
                          {{ option.name }}
                        </label>
                
                        <select
                          class="tv-product-popup__select"
                          data-option-name="{{ option.name }}"
                        >
                
                          <option value="">
                            Choose your {{ option.name | downcase }}
                          </option>
                
                          {% for value in option.values %}
                
                            <option value="{{ value }}">
                              {{ value }}
                            </option>
                
                          {% endfor %}
                
                        </select>
                
                      </div>
                
                    {% endunless %}
                
                  {% endfor %}
                
                
                  {%- comment -%}
                    ==========================================================
                    ADD TO CART
                    ==========================================================
                  {%- endcomment -%}
                
                  <button
                    type="button"
                    class="tv-product-popup__add"
                    data-product-id="{{ product.id }}"
                  >
                    <span>ADD TO CART</span>
                    <span class="tv-product-popup__arrow">→</span>
                  </button>
                
                </form>

              {% else %}

                <div class="tv-product-popup__sold-out">
                  SOLD OUT
                </div>

              {% endif %}

            </div>

          </div>

        {% endif %}

      {% endfor %}

    </div>

  </div>
</section>


<script>
  (function () {
    const section = document.getElementById(
      'tv-product-grid-{{ section.id }}'
    );

    if (!section) return;

    const hotspots = section.querySelectorAll(
      '.tv-product-hotspot'
    );

    const popups = section.querySelectorAll(
      '[data-popup]'
    );


    function openPopup(hotspot) {
      const popupId = hotspot.getAttribute(
        'aria-controls'
      );

      if (!popupId) return;

      const popup = document.getElementById(
        popupId
      );

      if (!popup) return;


      /*
       * Close any other popup.
       */

      popups.forEach(function (item) {
        item.classList.remove('is-open');
        item.setAttribute(
          'aria-hidden',
          'true'
        );
      });

      hotspots.forEach(function (item) {
        item.setAttribute(
          'aria-expanded',
          'false'
        );
      });


      /*
       * Open selected popup.
       */

      popup.classList.add('is-open');

      popup.setAttribute(
        'aria-hidden',
        'false'
      );

      hotspot.setAttribute(
        'aria-expanded',
        'true'
      );

      document.documentElement.classList.add(
        'tv-product-popup-open'
      );

      document.body.classList.add(
        'tv-product-popup-open'
      );
    }


    function closePopup(popup) {
      if (!popup) return;

      popup.classList.remove('is-open');

      popup.setAttribute(
        'aria-hidden',
        'true'
      );

      hotspots.forEach(function (item) {
        item.setAttribute(
          'aria-expanded',
          'false'
        );
      });

      document.documentElement.classList.remove(
        'tv-product-popup-open'
      );

      document.body.classList.remove(
        'tv-product-popup-open'
      );
    }


    /*
     * HOTSPOT CLICK
     */

    hotspots.forEach(function (hotspot) {

      hotspot.addEventListener(
        'click',
        function () {
          openPopup(hotspot);
        }
      );

    });


    /*
     * CLOSE BUTTON / OVERLAY
     */

    popups.forEach(function (popup) {

      const closeElements =
        popup.querySelectorAll(
          '[data-popup-close]'
        );

      closeElements.forEach(function (element) {

        element.addEventListener(
          'click',
          function () {
            closePopup(popup);
          }
        );

      });

    });


    /*
     * ESC KEY
     */

    document.addEventListener(
      'keydown',
      function (event) {

        if (event.key !== 'Escape') return;

        popups.forEach(function (popup) {

          if (
            popup.classList.contains(
              'is-open'
            )
          ) {
            closePopup(popup);
          }

        });

      }
    );

  })();
</script>


{% schema %}
{
  "name": "TV Product Grid",
  "tag": "section",
  "class": "section-tv-product-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 60
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TV Product Grid",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
