<section class="tv-product-grid">

  <div class="tv-product-grid__heading-wrapper">
    <h2 class="tv-product-grid__heading">
      {{ section.settings.heading }}
    </h2>
  </div>

  <div class="tv-product-grid__items">

    {% for block in section.blocks %}

      {% assign product = block.settings.product %}

      <article
        class="tv-product-grid__item"
        {{ block.shopify_attributes }}
      >

        <div class="tv-product-grid__image-wrapper">

          {% if block.settings.image != blank %}

            {{
              block.settings.image
              | image_url: width: 1000
              | image_tag:
                class: 'tv-product-grid__image',
                loading: 'lazy',
                widths: '433, 650, 866, 1000',
                sizes: '(min-width: 990px) 433px, (min-width: 750px) 33vw, 100vw',
                alt: block.settings.image.alt | default: section.settings.heading
            }}

          {% else %}

            <div class="tv-product-grid__placeholder">
              <span>Image {{ forloop.index }}</span>
            </div>

          {% endif %}


          {% comment %}
          =====================================================
          PRODUCT HOTSPOT
          =====================================================
          {% endcomment %}

          {% if product != blank %}

            <button
              type="button"
              class="tv-product-grid__hotspot"
              style="
                --hotspot-x: {{ block.settings.hotspot_x }}%;
                --hotspot-y: {{ block.settings.hotspot_y }}%;
              "
              data-product-id="{{ product.id }}"
              data-product-handle="{{ product.handle }}"
              aria-label="View {{ product.title | escape }}"
            >

              <span class="tv-product-grid__hotspot-circle">
                <span class="tv-product-grid__hotspot-plus"></span>
              </span>

            </button>

          {% endif %}

        </div>

      </article>

    {% endfor %}

  </div>

</section>


{% schema %}

{
  "name": "TV Product Grid",
  "tag": "section",
  "class": "tv-product-grid-section",

  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],

  "blocks": [
    {
      "type": "product_image",
      "name": "Product image",

      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Lifestyle image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "TV Product Grid",

      "blocks": [
        {
          "type": "product_image"
        },
        {
          "type": "product_image"
        },
        {
          "type": "product_image"
        },
        {
          "type": "product_image"
        },
        {
          "type": "product_image"
        },
        {
          "type": "product_image"
        }
      ]
    }
  ]
}

{% endschema %}
