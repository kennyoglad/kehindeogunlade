<section
  class="tv-product-grid-section"
  data-section-id="{{ section.id }}"
>
  <div class="tv-product-grid">

    {% if section.settings.heading != blank %}
      <h2 class="tv-product-grid__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="tv-product-grid__items">

      {% for block in section.blocks %}

        {% assign product = block.settings.product %}

        <article
          class="tv-product-grid__item"
          {{ block.shopify_attributes }}
        >

          {% if product != blank %}

            <div class="tv-product-grid__image-wrapper">

              {% if product.featured_image != blank %}

                {{
                  product.featured_image
                  | image_url: width: 866
                  | image_tag:
                    class: 'tv-product-grid__image',
                    loading: 'lazy',
                    widths: '433, 650, 866',
                    sizes: '(min-width: 1440px) 433px, calc(100vw - 32px)'
                }}

              {% else %}

                <div class="tv-product-grid__placeholder">
                  No product image
                </div>

              {% endif %}


              <button
                type="button"
                class="tv-product-grid__hotspot"
                style="
                  --hotspot-x: {{ block.settings.hotspot_x }}%;
                  --hotspot-y: {{ block.settings.hotspot_y }}%;
                "
                aria-label="View {{ product.title | escape }}"
                data-product-handle="{{ product.handle }}"
                data-product-id="{{ product.id }}"
              >

                <span
                  class="tv-product-grid__hotspot-circle"
                  aria-hidden="true"
                >
                  <span class="tv-product-grid__hotspot-plus"></span>
                </span>

              </button>

            </div>

          {% else %}

            <div class="tv-product-grid__image-wrapper">
              <div class="tv-product-grid__placeholder">
                Select a product
              </div>
            </div>

          {% endif %}

        </article>

      {% endfor %}

    </div>

  </div>
</section>

{% schema %}
{
  "name": "TV Product Grid",
  "tag": "section",
  "class": "tv-product-grid-section",

  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],

  "blocks": [
    {
      "type": "product_image",
      "name": "Product",

      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "TV Product Grid",

      "blocks": [
        {
          "type": "product_image",
          "settings": {
            "hotspot_x": 59.2,
            "hotspot_y": 53.6
          }
        },
        {
