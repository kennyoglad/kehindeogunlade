<section class="tv-product-grid">

  <div class="tv-product-grid__container">

    {% if section.settings.heading != blank %}
      <h2 class="tv-product-grid__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}


    <div class="tv-product-grid__items">

      {% for block in section.blocks %}

        {% assign product = block.settings.product %}

        <article
          class="tv-product-grid__item"
          {{ block.shopify_attributes }}
        >

          <div class="tv-product-grid__image-wrapper">

            {% if block.settings.image != blank %}

              {{
                block.settings.image
                | image_url: width: 866
                | image_tag:
                  class: 'tv-product-grid__image',
                  loading: 'lazy',
                  widths: '433, 650, 866',
                  sizes: '(min-width: 1400px) 433px, calc((100vw - 40px) / 3), 100vw',
                  alt: block.settings.image.alt | default: product.title
              }}

            {% elsif product != blank and product.featured_image != blank %}

              {{
                product.featured_image
                | image_url: width: 866
                | image_tag:
                  class: 'tv-product-grid__image',
                  loading: 'lazy',
                  widths: '433, 650, 866',
                  sizes: '(min-width: 1400px) 433px, calc((100vw - 40px) / 3), 100vw',
                  alt: product.title
              }}

            {% else %}

              <div class="tv-product-grid__placeholder">
                <span>No image selected</span>
              </div>

            {% endif %}


            {% if product != blank %}

              <button
                type="button"
                class="tv-product-grid__hotspot"
                style="
                  --hotspot-x: {{ block.settings.hotspot_x }}%;
                  --hotspot-y: {{ block.settings.hotspot_y }}%;
                "
                aria-label="View {{ product.title | escape }}"
                data-product-id="{{ product.id }}"
                data-product-handle="{{ product.handle }}"
                data-product-url="{{ product.url }}"
              >

                <span
                  class="tv-product-grid__hotspot-circle"
                  aria-hidden="true"
                >
                  <span class="tv-product-grid__hotspot-plus"></span>
                </span>

              </button>

            {% endif %}

          </div>

        </article>

      {% endfor %}

    </div>

  </div>

</section>


{% schema %}
{
  "name": "TV Product Grid",
  "tag": "section",
  "class": "tv-product-grid-section",

  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],

  "blocks": [
    {
      "type": "image_product",
      "name": "Product image",

      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Image displayed in this grid block."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Product opened when the hotspot is clicked."
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "TV Product Grid",

      "blocks": [
        {
          "type": "image_product",
          "settings": {
            "hotspot_x": 59.2,
            "hotspot_y": 53.6
          }
        },
        {
          "type": "image_product",
          "settings": {
            "hotspot_x": 82.4,
            "hotspot_y": 50
          }
        },
        {
          "type": "image_product",
          "settings": {
            "hotspot_x": 60.3,
            "hotspot_y": 18.5
          }
        },
        {
          "type": "image_product",
          "settings": {
            "hotspot_x": 69.7,
            "hotspot_y": 16
          }
        },
        {
          "type": "image_product",
          "settings": {
            "hotspot_x": 49,
            "hotspot_y": 23.4
          }
        },
        {
          "type": "image_product",
          "settings": {
            "hotspot_x": 73.1,
            "hotspot_y": 36.9
          }
        }
      ]
    }
  ]
}
{% endschema %}
