<div class="tv-product-grid">

  {% if section.settings.heading != blank %}

    <h2 class="tv-product-grid__heading">
      {{ section.settings.heading }}
    </h2>

  {% endif %}


  <div class="tv-product-grid__items">

    {% for block in section.blocks %}

      {% assign product = block.settings.product %}

      <article
        class="tv-product-grid__item"
        {{ block.shopify_attributes }}
      >

        {% if product != blank %}

          <div class="tv-product-grid__image-wrapper">

            {% if product.featured_image != blank %}

              {{
                product.featured_image
                | image_url: width: 866
                | image_tag:
                  class: 'tv-product-grid__image',
                  loading: 'lazy',
                  widths: '433, 650, 866',
                  sizes: '(min-width: 1440px) 433px, 33vw, 100vw',
                  alt: product.featured_image.alt | default: product.title
              }}

            {% else %}

              <div class="tv-product-grid__placeholder">
                No image available
              </div>

            {% endif %}


            {%- comment -%}
              Product data is embedded directly into the page.

              JavaScript reads this JSON when the hotspot is clicked.
              This means:
              - title is dynamic
              - price is dynamic
              - description is dynamic
              - variants are dynamic
              - variant IDs are dynamic
              - product image is dynamic
            {%- endcomment -%}

            <script
              type="application/json"
              class="tv-product-grid__product-data"
            >
              {
                "id": {{ product.id | json }},
                "handle": {{ product.handle | json }},
                "title": {{ product.title | json }},
                "description": {{ product.description | json }},
                "description_html": {{ product.description | json }},
                "url": {{ product.url | json }},
                "featured_image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | json }}{% else %}null{% endif %},
                "featured_image_alt": {% if product.featured_image %}{{ product.featured_image.alt | default: product.title | json }}{% else %}{{ product.title | json }}{% endif %},
                "price": {{ product.price | json }},
                "price_formatted": {{ product.price | money | json }},
                "available": {{ product.available | json }},
                "options": {{ product.options | json }},
                "variants": [
                  {% for variant in product.variants %}
                    {
                      "id": {{ variant.id | json }},
                      "title": {{ variant.title | json }},
                      "available": {{ variant.available | json }},
                      "price": {{ variant.price | json }},
                      "price_formatted": {{ variant.price | money | json }},
                      "option1": {{ variant.option1 | json }},
                      "option2": {{ variant.option2 | json }},
                      "option3": {{ variant.option3 | json }},
                      "featured_image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 900 | json }}{% else %}null{% endif %}
                    }{% unless forloop.last %},{% endunless %}
                  {% endfor %}
                ]
              }
            </script>


            {% if product != blank %}

              <button
                type="button"
                class="tv-product-grid__hotspot"
                style="
                  --hotspot-x: {{ block.settings.hotspot_x }}%;
                  --hotspot-y: {{ block.settings.hotspot_y }}%;
                "
                aria-label="View {{ product.title | escape }}"
                data-product-hotspot
              >

                <span
                  class="tv-product-grid__hotspot-circle"
                  aria-hidden="true"
                >

                  <span class="tv-product-grid__hotspot-plus"></span>

                </span>

              </button>

            {% endif %}

          </div>

        {% else %}

          <div class="tv-product-grid__image-wrapper">

            <div class="tv-product-grid__placeholder">
              Select a product
            </div>

          </div>

        {% endif %}

      </article>

    {% endfor %}

  </div>

</div>


{% schema %}
{
  "name": "TV Product Grid",
  "tag": "section",
  "class": "tv-product-grid-section",

  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],

  "blocks": [
    {
      "type": "product_image",
      "name": "Product",

      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "TV Product Grid",

      "blocks": [
        {
          "type": "product_image",
          "settings": {
            "hotspot_x": 59.2,
            "hotspot_y": 53.6
          }
        },
        {
          "type": "product_image",
          "settings": {
            "hotspot_x": 82.4,
            "hotspot_y": 50
          }
        },
        {
          "type": "product_image",
          "settings": {
            "hotspot_x": 60.3,
            "hotspot_y": 18.5
          }
        },
        {
          "type": "product_image",
          "settings": {
            "hotspot_x": 69.7,
            "hotspot_y": 16
          }
        },
        {
          "type": "product_image",
          "settings": {
            "hotspot_x": 49,
            "hotspot_y": 23.4
          }
        },
        {
          "type": "product_image",
          "settings": {
            "hotspot_x": 73.1,
            "hotspot_y": 36.9
          }
        }
      ]
    }
  ]
}
{% endschema %}
