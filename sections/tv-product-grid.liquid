{{ 'tv-product.grid.css' | asset_url | stylesheet_tag }}

<section
  id="tv-product-grid-{{ section.id }}"
  class="tv-product-grid"
  data-section-id="{{ section.id }}"
>
  <div class="tv-product-grid__container">

    {% if section.settings.heading != blank %}
      <h2 class="tv-product-grid__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="tv-product-grid__items">

      {% for block in section.blocks %}
        {% assign product = block.settings.product %}

        {% if product != blank %}

          {% assign featured_image = product.featured_image %}

          <article
            class="tv-product-card"
            {{ block.shopify_attributes }}
            data-product-id="{{ product.id }}"
          >

            <div class="tv-product-card__image-wrapper">

              {% if featured_image != blank %}

                {{
                  featured_image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '375, 550, 750, 900, 1200',
                    sizes: '(min-width: 990px) 33vw, 100vw',
                    class: 'tv-product-card__image',
                    alt: featured_image.alt | default: product.title
                }}

              {% else %}

                <div class="tv-product-card__image-placeholder">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>

              {% endif %}

              {% comment %}
                Product hotspot.
                Position is controlled from the Theme Customizer.
              {% endcomment %}

              <button
                type="button"
                class="tv-product-hotspot"
                style="
                  --hotspot-x: {{ block.settings.hotspot_x }}%;
                  --hotspot-y: {{ block.settings.hotspot_y }}%;
                "
                aria-label="View {{ product.title | escape }}"
                aria-controls="tv-product-popup-{{ section.id }}-{{ block.id }}"
                aria-expanded="false"
              >
                <span class="tv-product-hotspot__circle">
                  <span class="tv-product-hotspot__plus"></span>
                </span>
              </button>

            </div>

          </article>


          {% comment %}
            PRODUCT POPUP
          {% endcomment %}

          <div
            id="tv-product-popup-{{ section.id }}-{{ block.id }}"
            class="tv-product-popup"
            aria-hidden="true"
            data-popup
          >

            <div
              class="tv-product-popup__overlay"
              data-popup-close
            ></div>

            <div
              class="tv-product-popup__content"
              role="dialog"
              aria-modal="true"
              aria-label="{{ product.title | escape }}"
            >

              <button
                type="button"
                class="tv-product-popup__close"
                data-popup-close
                aria-label="Close"
              >
                &times;
              </button>


              <div class="tv-product-popup__top">

                <div class="tv-product-popup__image">

                  {% if featured_image != blank %}

                    {{
                      featured_image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        class: 'tv-product-popup__image-element',
                        alt: featured_image.alt | default: product.title
                    }}

                  {% endif %}

                </div>


                <div class="tv-product-popup__details">

                  <h3 class="tv-product-popup__title">
                    {{ product.title }}
                  </h3>

                  <div class="tv-product-popup__price">

                    {% if product.compare_at_price > product.price %}

                      <span class="tv-product-popup__price-current">
                        {{ product.price | money }}
                      </span>

                      <span class="tv-product-popup__price-compare">
                        {{ product.compare_at_price | money }}
                      </span>

                    {% else %}

                      <span>
                        {{ product.price | money }}
                      </span>

                    {% endif %}

                  </div>

                  {% if product.description != blank %}

                    <div class="tv-product-popup__description">
                      {{ product.description | strip_html | truncate: 180 }}
                    </div>

                  {% endif %}

                </div>

              </div>


              {% if product.available %}

                <form class="tv-product-popup__form">

                 <script type="application/json" class="tv-product-popup__variants">
                  {{ product.variants | json }}
                </script>
                
                  {% for option in product.options_with_values %}
                
                    {% if option.name == 'Color' %}
                
                      <div class="tv-product-popup__option">

                        <label class="tv-product-popup__label">
                          {{ option.name }}
                        </label>
                      
                        <div class="tv-product-popup__colors">
                      
                          {% for value in option.values %}
                      
                            {% assign colour = value | strip | downcase %}
                            {% assign accent = "#DDDDDD" %}
                      
                            {% case colour %}
                              {% when 'white' %}
                                {% assign accent = "#FFFFFF" %}
                              {% when 'black' %}
                                {% assign accent = "#000000" %}
                              {% when 'blue' %}
                                {% assign accent = "#0D499F" %}
                              {% when 'red' %}
                                {% assign accent = "#B20F36" %}
                              {% when 'grey', 'gray' %}
                                {% assign accent = "#AFAFB7" %}
                              {% when 'green' %}
                                {% assign accent = "#4D8B31" %}
                              {% when 'brown' %}
                                {% assign accent = "#7A4A2E" %}
                              {% when 'orange' %}
                                {% assign accent = "#DD7A1D" %}
                              {% when 'beige' %}
                                {% assign accent = "#DCC7A1" %}
                              {% when 'pink' %}
                                {% assign accent = "#E6A5B8" %}
                              {% when 'yellow' %}
                                {% assign accent = "#E4C63C" %}
                            {% endcase %}
                      
                            <button
                              type="button"
                              class="tv-product-popup__color"
                              data-color="{{ value | escape }}"
                              style="--tv-color-accent: {{ accent }};"
                            >
                              {{ value }}
                            </button>
                      
                          {% endfor %}
                      
                        </div>
                      
                      </div>
                
                    {% endif %}
                
                  {% endfor %}
                
                
                  {%- comment -%}
                    ==========================================================
                    ALL OTHER OPTIONS — AFTER COLOR
                    ==========================================================
                  {%- endcomment -%}
                
                  {% for option in product.options_with_values %}
                
                    {% unless option.name == 'Color' %}
                      
                        <div class="tv-product-popup__option tv-product-popup__option--size">
                
                        <label class="tv-product-popup__label">
                          {{ option.name }}
                        </label>
                
                        <select
                          class="tv-product-popup__select"
                          data-option-name="{{ option.name }}"
                        >
                
                          <option value="">
                            Choose your {{ option.name | downcase }}
                          </option>
                
                          {% for value in option.values %}
                
                            <option value="{{ value }}">
                              {{ value }}
                            </option>
                
                          {% endfor %}
                
                        </select>
                
                      </div>
                
                    {% endunless %}
                
                  {% endfor %}
                
                
                  {%- comment -%}
                    ==========================================================
                    ADD TO CART
                    ==========================================================
                  {%- endcomment -%}
                
                  <button
                    type="button"
                    class="tv-product-popup__add"
                    data-product-id="{{ product.id }}"
                    data-product-handle="{{ product.handle }}"
                  >
                    <span>ADD TO CART</span>
                    <span class="tv-product-popup__arrow">→</span>
                  </button>
                
                </form>

              {% else %}

                <div class="tv-product-popup__sold-out">
                  SOLD OUT
                </div>

              {% endif %}

            </div>

          </div>

        {% endif %}

      {% endfor %}

    </div>

  </div>
</section>


<script>
  (function () {
    const section = document.getElementById(
      'tv-product-grid-{{ section.id }}'
    );

    if (!section) return;

    const hotspots = section.querySelectorAll(
      '.tv-product-hotspot'
    );

    const popups = section.querySelectorAll(
      '[data-popup]'
    );


    function openPopup(hotspot) {
      const popupId = hotspot.getAttribute(
        'aria-controls'
      );

      if (!popupId) return;

      const popup = document.getElementById(
        popupId
      );

      if (!popup) return;


      /*
       * Close any other popup.
       */

      popups.forEach(function (item) {
        item.classList.remove('is-open');
        item.setAttribute(
          'aria-hidden',
          'true'
        );
      });

      hotspots.forEach(function (item) {
        item.setAttribute(
          'aria-expanded',
          'false'
        );
      });


      /*
       * Open selected popup.
       */

      popup.classList.add('is-open');

      popup.setAttribute(
        'aria-hidden',
        'false'
      );

      hotspot.setAttribute(
        'aria-expanded',
        'true'
      );

      document.documentElement.classList.add(
        'tv-product-popup-open'
      );

      document.body.classList.add(
        'tv-product-popup-open'
      );
    }


    function closePopup(popup) {
      if (!popup) return;

      popup.classList.remove('is-open');

      popup.setAttribute(
        'aria-hidden',
        'true'
      );

      hotspots.forEach(function (item) {
        item.setAttribute(
          'aria-expanded',
          'false'
        );
      });

      document.documentElement.classList.remove(
        'tv-product-popup-open'
      );

      document.body.classList.remove(
        'tv-product-popup-open'
      );
    }


    /*
     * HOTSPOT CLICK
     */

    hotspots.forEach(function (hotspot) {

      hotspot.addEventListener(
        'click',
        function () {
          openPopup(hotspot);
        }
      );

    });


    /*
     * CLOSE BUTTON / OVERLAY
     */

    popups.forEach(function (popup) {

      const closeElements =
        popup.querySelectorAll(
          '[data-popup-close]'
        );

      closeElements.forEach(function (element) {

        element.addEventListener(
          'click',
          function () {
            closePopup(popup);
          }
        );

      });

    });


    /*
     * ESC KEY
     */

    document.addEventListener(
      'keydown',
      function (event) {

        if (event.key !== 'Escape') return;

        popups.forEach(function (popup) {

          if (
            popup.classList.contains(
              'is-open'
            )
          ) {
            closePopup(popup);
          }

        });

      }
    );

  })();


/*
 * ==========================================================
 * PRODUCT VARIANT + ADD TO CART
 * ==========================================================
 */

(function () {

  const section = document.getElementById(
    'tv-product-grid-{{ section.id }}'
  );

  if (!section) return;


  /*
   * ----------------------------------------------------------
   * Find the variant matching the current selections
   * ----------------------------------------------------------
   */
function getSelectedVariant(form) {

  const variantsElement = form.querySelector(
    '.tv-product-popup__variants'
  );

  if (!variantsElement) {
    console.error('Variant JSON not found.');
    return null;
  }

  let variants;

  try {
    variants = JSON.parse(
      variantsElement.textContent
    );
  } catch (error) {
    console.error(
      'Unable to parse product variants:',
      error
    );
    return null;
  }

  /*
   * Build the selected options by OPTION NAME.
   */

  const selections = {};

  /*
   * Color
   */
  const activeColor = form.querySelector(
    '.tv-product-popup__color.active'
  );

  if (activeColor) {
    selections.Color =
      activeColor.dataset.color.trim();
  }

  /*
   * Other options such as Size
   */
  const selects = form.querySelectorAll(
    '.tv-product-popup__select'
  );

  selects.forEach(function (select) {

    const optionName =
      select.dataset.optionName ||
      select.closest(
        '.tv-product-popup__option'
      )?.querySelector(
        '.tv-product-popup__label'
      )?.textContent.trim();

    if (!optionName) return;

    selections[optionName] =
      select.value.trim();

  });


  console.log(
    'Selected options:',
    selections
  );

  console.log(
    'Available variants:',
    variants
  );


  /*
   * Make sure every required option
   * has a selected value.
   */

  const requiredOptionNames = [];

  /*
   * Color
   */
  if (
    form.querySelector(
      '.tv-product-popup__colors'
    )
  ) {
    requiredOptionNames.push('Color');
  }

  /*
   * Select options
   */
  selects.forEach(function (select) {

    const optionName =
      select.dataset.optionName ||
      select.closest(
        '.tv-product-popup__option'
      )?.querySelector(
        '.tv-product-popup__label'
      )?.textContent.trim();

    if (
      optionName &&
      !requiredOptionNames.includes(optionName)
    ) {
      requiredOptionNames.push(optionName);
    }

  });


  const missingOption =
    requiredOptionNames.find(function (name) {

      return !selections[name];

    });


  if (missingOption) {

    console.warn(
      'Missing variant option:',
      missingOption
    );

    return null;

  }


  /*
   * Find the Shopify variant.
   *
   * Shopify stores the variant values as
   * option1, option2, option3.
   */

  return variants.find(function (variant) {

    const variantOptions = [
      variant.option1,
      variant.option2,
      variant.option3
    ].filter(function (value) {
      return value !== null &&
             value !== undefined;
    });


    return requiredOptionNames.every(
      function (optionName, index) {

        const selectedValue =
          selections[optionName];

        return variantOptions.includes(
          selectedValue
        );

      }
    );

  }) || null;

}


  /*
   * ----------------------------------------------------------
   * Color selection
   * ----------------------------------------------------------
   */

  section
    .querySelectorAll('.tv-product-popup__colors')
    .forEach(function (group) {

      const buttons = group.querySelectorAll(
        '.tv-product-popup__color'
      );


      buttons.forEach(function (button) {

        button.addEventListener(
          'click',
          function () {

            buttons.forEach(function (btn) {
              btn.classList.remove('active');
            });

            button.classList.add('active');

          }
        );

      });

    });


  /*
   * ----------------------------------------------------------
   * Add product to Shopify cart
   * ----------------------------------------------------------
   */

async function addToCart(items) {
  const response = await fetch('/cart/add.js', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Accept': 'application/json'
    },
    body: JSON.stringify({
      items: items
    })
  });

  if (!response.ok) {
    let errorData = null;

    try {
      errorData = await response.json();
    } catch (error) {}

    throw new Error(
      errorData?.description ||
      'Unable to add product to cart.'
    );
  }

  return response.json();
}


  /*
   * ----------------------------------------------------------
   * Find Soft Winter Jacket
   * ----------------------------------------------------------
   */

async function getDarkWinterJacketVariant() {
  const response = await fetch(
    '/products/dark-winter-jacket.js',
    {
      headers: {
        'Accept': 'application/json'
      }
    }
  );

  if (!response.ok) {
    throw new Error(
      'Could not load Dark Winter Jacket product.'
    );
  }

  const product = await response.json();

  console.log(
    'Dark Winter Jacket product:',
    product
  );

  const variant = product.variants.find(
    function (variant) {
      return variant.available;
    }
  );

  if (!variant) {
    throw new Error(
      'Dark Winter Jacket has no available variant.'
    );
  }

  return variant;
}


  /*
   * ----------------------------------------------------------
   * ADD TO CART BUTTON
   * ----------------------------------------------------------
   */

  section
    .querySelectorAll('.tv-product-popup__add')
    .forEach(function (button) {

      button.addEventListener(
        'click',
        async function () {

          const form = button.closest(
            '.tv-product-popup__form'
          );

          if (!form) return;


          const variant = getSelectedVariant(
            form
          );


          /*
           * No complete variant selected.
           */

          if (!variant) {

            alert(
              'Please select a color and size.'
            );

            return;

          }


          /*
           * Variant unavailable.
           */

          if (!variant.available) {

            alert(
              'This variant is currently unavailable.'
            );

            return;

          }


          /*
           * Prevent double-clicks.
           */

          button.disabled = true;

          const originalText =
            button.querySelector('span');

          if (originalText) {
            originalText.textContent =
              'ADDING...';
          }


          try {

           /*
 * Build the cart items.
 */

const cartItems = [
  {
    id: variant.id,
    quantity: 1
  }
];


/*
 * Check for Black + Medium.
 */

const colorButton =
  form.querySelector(
    '.tv-product-popup__color.active'
  );

const sizeSelect =
  form.querySelector(
    '.tv-product-popup__select'
  );


const selectedColor =
  colorButton
    ? colorButton.dataset.color.trim().toLowerCase()
    : '';


const selectedSize =
  sizeSelect
    ? sizeSelect.value.trim().toLowerCase()
    : '';


const isBlackMedium =
  selectedColor === 'black' &&
  selectedSize === 'medium';


/*
 * If Black + Medium, find the
 * Dark Winter Jacket variant first.
 */

if (isBlackMedium) {

  const jacketVariant =
    await getDarkWinterJacketVariant();


  cartItems.push({
    id: jacketVariant.id,
    quantity: 1
  });

}


/*
 * Add everything in ONE Shopify request.
 */

await addToCart(cartItems);


/*
 * Button feedback.
 */

if (originalText) {
  originalText.textContent =
    'ADDED TO CART';
}


/*
 * Go to cart only after everything
 * has successfully been added.
 */

window.location.href = '/cart';


          } catch (error) {

            console.error(
              'Add to cart failed:',
              error
            );


            alert(
              error.message ||
              'Unable to add product to cart.'
            );


            if (originalText) {
              originalText.textContent =
                'ADD TO CART';
            }

          } finally {

            button.disabled = false;

          }

        }
      );

    });

})();

</script>


{% schema %}
{
  "name": "TV Product Grid",
  "tag": "section",
  "class": "section-tv-product-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 60
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TV Product Grid",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
