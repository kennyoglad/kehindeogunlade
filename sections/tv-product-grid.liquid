          }
        },
        {
          "type": "product_image",
          "settings": {
            "hotspot_x": 49.8,
            "hotspot_y": 23.4
          }
        },
        {
          "type": "product_image",
          "settings": {
            "hotspot_x": 73.2,
            "hotspot_y": 36.9
          }
        }
      ]
    }

  ]

}
{% endschema %}
