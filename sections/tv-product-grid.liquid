<section
  class="tv-product-grid"
  id="tv-product-grid-{{ section.id }}"
>
  <div class="tv-product-grid__inner">

    {% if section.settings.heading != blank %}
      <h2 class="tv-product-grid__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="tv-product-grid__grid">

      {% for block in section.blocks %}
        <article
          class="tv-product-grid__card"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.image != blank %}
            <div class="tv-product-grid__image-wrapper">

              {{
                block.settings.image
                | image_url: width: 1000
                | image_tag:
                  class: 'tv-product-grid__image',
                  loading: 'lazy',
                  widths: '433, 650, 866, 1000',
                  sizes: '(min-width: 1440px) 433px, 33vw',
                  alt: block.settings.image.alt | default: block.settings.product_title
              }}

              {% if block.settings.product_link != blank %}
                <a
                  href="{{ block.settings.product_link }}"
                  class="tv-product-grid__hotspot"
                  style="
                    --hotspot-x: {{ block.settings.hotspot_x }}%;
                    --hotspot-y: {{ block.settings.hotspot_y }}%;
                  "
                  aria-label="{{ block.settings.product_title | escape }}"
                >
                  <span class="tv-product-grid__hotspot-icon" aria-hidden="true">
                    +
                  </span>
                </a>
              {% endif %}

            </div>
          {% endif %}

        </article>
      {% endfor %}

    </div>

  </div>
</section>

{% schema %}
{
  "name": "TV Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product image"
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Product title",
          "default": "Product"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Product link"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TV Product Grid",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
