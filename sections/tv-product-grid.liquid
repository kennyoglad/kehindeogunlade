<div style="background: yellow; color: black; padding: 30px; font-size: 24px;">
  TV PRODUCT GRID IS RENDERING
</div>

<section
  class="tv-product-grid"
  id="tv-product-grid-{{ section.id }}"
>
  <div class="tv-product-grid__inner">

    {% if section.settings.heading != blank %}
      <h2 class="tv-product-grid__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="tv-product-grid__items">

      {% for block in section.blocks %}
        <article
          class="tv-product-grid__item"
          {{ block.shopify_attributes }}
        >

         
<div class="tv-product-grid__items">

  {% for block in section.blocks %}

    <article
      class="tv-product-grid__item"
      {{ block.shopify_attributes }}
    >
      <div
        class="tv-product-grid__image-wrapper"
        style="
          width: 100%;
          aspect-ratio: 433 / 444;
          background: #eeeeee;
          display: flex;
          align-items: center;
          justify-content: center;
        "
      >
        Product {{ forloop.index }}
      </div>
    </article>

  {% endfor %}

</div>
        </article>
      {% endfor %}

    </div>

  </div>
</section>

{% schema %}
{
  "name": "TV Product Grid",
  "tag": "section",
  "class": "section-tv-product-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "image_product",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TV Product Grid",
      "blocks": [
        {
          "type": "image_product"
        },
        {
          "type": "image_product"
        },
        {
          "type": "image_product"
        },
        {
          "type": "image_product"
        },
        {
          "type": "image_product"
        },
        {
          "type": "image_product"
        }
      ]
    }
  ]
}
{% endschema %}


