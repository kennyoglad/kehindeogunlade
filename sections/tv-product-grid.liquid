<section class="tv-product-grid">

  <div class="tv-product-grid__heading-wrapper">
    <h2 class="tv-product-grid__heading">
      {{ section.settings.heading }}
    </h2>
  </div>

  <div class="tv-product-grid__items">

    {% for block in section.blocks %}

      {% assign product = block.settings.product %}

      <article
        class="tv-product-grid__item"
        {{ block.shopify_attributes }}
      >

        <div class="tv-product-grid__image-wrapper">

          {% if block.settings.image != blank %}

            {{
              block.settings.image
              | image_url: width: 1000
              | image_tag:
                class: 'tv-product-grid__image',
                loading: 'lazy',
                widths: '433, 650, 866, 1000',
                sizes: '(min-width: 990px) 433px, (min-width: 750px) 33vw, 100vw',
                alt: block.settings.image.alt | default: product.title | default: section.settings.heading
            }}

          {% else %}

            <div class="tv-product-grid__placeholder">
              <span>Image {{ forloop.index }}</span>
            </div>

          {% endif %}


         
<div
  style="
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 50px;
    height: 50px;
    background: red;
    border-radius: 50%;
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 30px;
    font-weight: bold;
  "
>
  +
</div>
        </div>

      </article>

    {% endfor %}

  </div>

</section>


{% schema %}
{
  "name": "TV Product Grid",
  "tag": "section",
  "class": "section-tv-product-grid",

  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],

  "blocks": [
    {
      "type": "product_image",
      "name": "Product image",

      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Lifestyle image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "TV Product Grid",

      "blocks": [
        {
          "type": "product_image"
        },
        {
          "type": "product_image"
        },
        {
          "type": "product_image"
        },
        {
          "type": "product_image"
        },
        {
          "type": "product_image"
        },
        {
          "type": "product_image"
        }
      ]
    }
  ]
}
{% endschema %}
