<div class="tv-banner">

  {%- comment -%}
  ==========================================================
  TV BANNER — FIGMA FRAME
  Desktop reference:
  Width: 1440px
  Height: 878px

  Header: 64px
  Main:   780px
  Footer: 34px
  ==========================================================
  {%- endcomment -%}

  <!-- ======================================================
       HEADER
       Figma: 1440 × 64px
       ====================================================== -->

  <header class="tv-banner__header">

    <div class="tv-banner__header-inner">

      <button
        type="button"
        class="tv-banner__menu"
        aria-label="Open menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

      <!-- LOGO -->
      <div class="tv-banner__logo">

        {% if section.settings.logo != blank %}

          {{
            section.settings.logo
            | image_url: width: 500
            | image_tag:
              class: 'tv-banner__logo-image',
              loading: 'eager',
              widths: '150, 250, 350, 500',
              sizes: '151px',
              alt: section.settings.logo.alt | default: section.settings.brand_text
          }}

        {% else %}

          <span class="tv-banner__brand-text">
            {{ section.settings.brand_text }}
          </span>

        {% endif %}

      </div>


      <!-- HEADER MESSAGE -->
      <div class="tv-banner__header-message">
        {{ section.settings.header_text }}
      </div>


      <!-- HEADER BUTTON -->
      {% if section.settings.header_button_text != blank %}

        <a
          href="{{ section.settings.header_button_link | default: '#' }}"
          class="tv-banner__header-button"
        >

          <span class="tv-banner__header-button-text">
            {{ section.settings.header_button_text }}
          </span>

          <span
            class="tv-banner__header-button-arrow"
            aria-hidden="true"
          >
            <span class="tv-banner__header-arrow-line"></span>
            <span class="tv-banner__header-arrow-head"></span>
          </span>

        </a>

      {% endif %}

    </div>

  </header>


  <!-- ======================================================
       MAIN
       Figma: 1440 × 780px
       ====================================================== -->

  <main class="tv-banner__main">

  

<div
  class="tv-banner__canvas"
  style="
    {% if section.settings.banner_artwork != blank %}
      --tv-banner-artwork: url('{{ section.settings.banner_artwork | image_url: width: 1440 }}');
    {% else %}
      --tv-banner-artwork: url('{{ 'banner.svg' | asset_url }}');
    {% endif %}

    {% if section.settings.mobile_banner_artwork != blank %}
      --tv-banner-artwork-mobile: url('{{ section.settings.mobile_banner_artwork | image_url: width: 750 }}');
    {% else %}
      --tv-banner-artwork-mobile: url('{{ 'mobile.svg' | asset_url }}');
    {% endif %}
  "
>

    <div class="tv-banner__content">

      {% if section.settings.heading != blank %}
        <h1 class="tv-banner__heading">
          {{ section.settings.heading }}
        </h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="tv-banner__description tv-banner__description--desktop">
          {{ section.settings.description }}
        </div>
      {% endif %}
      
      {% if section.settings.mobile_description != blank %}
        <div class="tv-banner__description tv-banner__description--mobile">
          {{ section.settings.mobile_description }}
        </div>
      {% endif %}

      {% if section.settings.main_button_text != blank %}
        <a
          href="{{ section.settings.main_button_link | default: '#' }}"
          class="tv-banner__main-button"
        >
          <span class="tv-banner__main-button-text">
            {{ section.settings.main_button_text }}
          </span>

          <span
            class="tv-banner__main-button-arrow"
            aria-hidden="true"
          >
            <span class="tv-banner__main-arrow-line"></span>
            <span class="tv-banner__main-arrow-head"></span>
          </span>
        </a>
      {% endif %}

    </div>

  </div>

</main>


  <!-- ======================================================
       FOOTER
       Figma: 1440 × 34px
       ====================================================== -->

  <footer class="tv-banner__footer">

    <div class="tv-banner__footer-text tv-banner__footer-text--desktop">
      {{ section.settings.bottom_text }}
    </div>
    
    <div class="tv-banner__footer-text tv-banner__footer-text--mobile">
      SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR
    </div>

  </footer>

</div>


{% schema %}
{
  "name": "TV Banner",
  "tag": "section",
  "class": "tv-banner-section",

  "settings": [

    {
      "type": "header",
      "content": "Header"
    },

    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },

    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text",
      "default": "TISSO VISION"
    },

    {
      "type": "text",
      "id": "header_text",
      "label": "Header message",
      "default": "Find the ideal gift for your loved ones."
    },

    {
      "type": "text",
      "id": "header_button_text",
      "label": "Header button text",
      "default": "CHOOSE GIFT"
    },

    {
      "type": "url",
      "id": "header_button_link",
      "label": "Header button link"
    },


    {
      "type": "header",
      "content": "Main Artwork"
    },

    {
      "type": "image_picker",
      "id": "banner_artwork",
      "label": "Desktop banner artwork",
      "info": "Complete desktop banner artwork. Figma: 1440 × 780px"
    },
    
    {
      "type": "image_picker",
      "id": "mobile_banner_artwork",
      "label": "Mobile banner artwork",
      "info": "Mobile banner artwork. Used only on screens below 750px."
    },

    {
      "type": "header",
      "content": "Main Content"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    
    {
      "type": "richtext",
      "id": "mobile_description",
      "label": "Mobile description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination.</p>"
    },

    {
      "type": "text",
      "id": "main_button_text",
      "label": "Main button text",
      "default": "SHOP NOW"
    },

    {
      "type": "url",
      "id": "main_button_link",
      "label": "Main button link"
    },


    {
      "type": "header",
      "content": "Bottom Bar"
    },

    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }

  ],

  "presets": [
    {
      "name": "TV Banner"
    }
  ]
}
{% endschema %}
