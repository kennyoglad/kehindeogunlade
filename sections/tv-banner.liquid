<section
  id="TvBanner-{{ section.id }}"
  class="tv-banner"
  data-section-id="{{ section.id }}"
>
  {%- comment -%}
    ==========================================================
    HEADER / FRAME 1956
    ==========================================================
  {%- endcomment -%}

  <header class="tv-banner__header">

    <div class="tv-banner__brand">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 500
          | image_tag:
            class: 'tv-banner__logo',
            loading: 'eager',
            widths: '150, 250, 350, 500',
            sizes: '(max-width: 749px) 120px, 180px',
            alt: section.settings.logo.alt | default: section.settings.brand_text
        }}
      {% else %}
        <span class="tv-banner__brand-text">
          {{ section.settings.brand_text }}
        </span>
      {% endif %}
    </div>

    <div class="tv-banner__header-message">
      {{ section.settings.header_text }}
    </div>

    {% if section.settings.header_button_text != blank %}
      <a
        href="{{ section.settings.header_button_link | default: '#' }}"
        class="tv-banner__header-button"
        {% if section.settings.header_button_link contains 'http' %}
          target="_blank"
          rel="noopener noreferrer"
        {% endif %}
        aria-label="{{ section.settings.header_button_text }}"
      >
        <span class="tv-banner__header-button-text">
          {{ section.settings.header_button_text }}
        </span>

        <span
          class="tv-banner__header-button-arrow"
          aria-hidden="true"
        >
          <span class="tv-banner__arrow-line"></span>
          <span class="tv-banner__arrow-head"></span>
        </span>
      </a>
    {% endif %}

  </header>


  {%- comment -%}
    ==========================================================
    MAIN BANNER
    ==========================================================
  {%- endcomment -%}

  <div
    class="tv-banner__visual"
    {% if section.settings.banner_image != blank %}
      style="background-image: url('{{ section.settings.banner_image | image_url: width: 2400 }}');"
    {% endif %}
  >

    {% if section.settings.banner_image == blank %}
      <div class="tv-banner__placeholder"></div>
    {% endif %}

    {% if section.settings.show_overlay %}
      <div
        class="tv-banner__overlay"
        style="--tv-banner-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
      ></div>
    {% endif %}

    <div class="tv-banner__main">

      {% if section.settings.heading != blank %}
        <h1 class="tv-banner__heading">
          {{ section.settings.heading }}
        </h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="tv-banner__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.main_button_text != blank %}
        <a
          href="{{ section.settings.main_button_link | default: '#' }}"
          class="tv-banner__main-button"
          {% if section.settings.main_button_link contains 'http' %}
            target="_blank"
            rel="noopener noreferrer"
          {% endif %}
        >
          <span class="tv-banner__main-button-text">
            {{ section.settings.main_button_text }}
          </span>

          <span
            class="tv-banner__main-button-arrow"
            aria-hidden="true"
          >
            <span class="tv-banner__arrow-line"></span>
            <span class="tv-banner__arrow-head"></span>
          </span>
        </a>
      {% endif %}

    </div>


    {% if section.settings.bottom_text != blank %}
      <div class="tv-banner__bottom">
        {{ section.settings.bottom_text }}
      </div>
    {% endif %}

  </div>
</section>


{% schema %}
{
  "name": "TV Banner",
  "tag": "section",
  "class": "tv-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text",
      "default": "TISSO VISION"
    },
    {
      "type": "text",
      "id": "header_text",
      "label": "Header message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "header_button_text",
      "label": "Header button text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "header_button_link",
      "label": "Header button link"
    },

    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner background image"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay",
      "default": false
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 10
    },

    {
      "type": "header",
      "content": "Main content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination.<br>Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "text",
      "id": "main_button_text",
      "label": "Main button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "main_button_link",
      "label": "Main button link"
    },

    {
      "type": "header",
      "content": "Bottom message"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "TV Banner"
    }
  ]
}
{% endschema %}
