<div class="tv-page">

  <!-- ==========================================================
       TV BANNER
       Figma: 1440 × 878px
       Header: 64px
       Hero: 780px
       Footer: 34px
  =========================================================== -->

  <section class="tv-banner">

    <!-- ========================================================
         HEADER
         Figma: 1440 × 64px
    ========================================================= -->

    <header class="tv-banner__header">

      <!-- LOGO -->
      <div class="tv-banner__logo">
        {% if section.settings.logo != blank %}

          {{
            section.settings.logo
            | image_url: width: 500
            | image_tag:
              class: 'tv-banner__logo-image',
              loading: 'eager',
              widths: '150, 250, 350, 500',
              sizes: '151px',
              alt: section.settings.logo.alt | default: section.settings.brand_text
          }}

        {% else %}

          <span class="tv-banner__brand-text">
            {{ section.settings.brand_text }}
          </span>

        {% endif %}
      </div>


      <!-- HEADER MESSAGE -->
      <div class="tv-banner__header-message">
        {{ section.settings.header_text }}
      </div>


      <!-- HEADER BUTTON -->
      {% if section.settings.header_button_text != blank %}

        <a
          href="{{ section.settings.header_button_link | default: '#' }}"
          class="tv-banner__header-button"
        >

          <span class="tv-banner__header-button-text">
            {{ section.settings.header_button_text }}
          </span>

          <span
            class="tv-banner__header-button-arrow"
            aria-hidden="true"
          >
            <span class="tv-banner__header-arrow-line"></span>
            <span class="tv-banner__header-arrow-head"></span>
          </span>

        </a>

      {% endif %}

    </header>


    <!-- ========================================================
         HERO
         Figma: 1440 × 780px
    ========================================================= -->

    <div class="tv-banner__hero">


      <!-- TOP ARTWORK -->
      <div class="tv-banner__artwork tv-banner__artwork--top">

        <img
          src="{{ 'artworktop.png' | asset_url }}"
          class="tv-banner__artwork-image"
          alt="Gift Guide artwork"
          loading="eager"
        >

      </div>


      <!-- BOTTOM ARTWORK -->
      <div class="tv-banner__artwork tv-banner__artwork--bottom">

        <img
          src="{{ 'artworkbottom.png' | asset_url }}"
          class="tv-banner__artwork-image"
          alt="Gift Guide artwork"
          loading="eager"
        >

      </div>


      <!-- MAIN CONTENT -->
      <div class="tv-banner__content">

        {% if section.settings.heading != blank %}

          <h1 class="tv-banner__heading">
            {{ section.settings.heading }}
          </h1>

        {% endif %}


        {% if section.settings.description != blank %}

          <div class="tv-banner__description">
            {{ section.settings.description }}
          </div>

        {% endif %}


        {% if section.settings.main_button_text != blank %}

          <a
            href="{{ section.settings.main_button_link | default: '#' }}"
            class="tv-banner__main-button"
          >

            <span class="tv-banner__main-button-text">
              {{ section.settings.main_button_text }}
            </span>

            <span
              class="tv-banner__main-button-arrow"
              aria-hidden="true"
            >
              <span class="tv-banner__main-arrow-line"></span>
              <span class="tv-banner__main-arrow-head"></span>
            </span>

          </a>

        {% endif %}

      </div>

    </div>


    <!-- ========================================================
         FOOTER
         Figma: 1440 × 34px
    ========================================================= -->

    <footer class="tv-banner__footer">

      <span class="tv-banner__footer-text">
        SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL
      </span>

    </footer>

  </section>


  <!-- ==========================================================
       PRODUCT GRID
       Figma: 1337 × 981px
       Gap from banner: 90px
  =========================================================== -->

  <section class="tv-product-grid">

    {% if section.settings.heading != blank %}
      <h2 class="tv-product-grid__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}


    <div class="tv-product-grid__items">

      {% for block in section.blocks %}

        <article
          class="tv-product-grid__item"
          {{ block.shopify_attributes }}
        >

          <div class="tv-product-grid__image-wrapper">

            {% if block.settings.image != blank %}

              {{
                block.settings.image
                | image_url: width: 866
                | image_tag:
                  class: 'tv-product-grid__image',
                  loading: 'lazy',
                  widths: '433, 650, 866',
                  sizes: '(min-width: 1440px) 433px, 32.4vw, 100vw'
              }}

            {% else %}

              <div class="tv-product-grid__placeholder">
                Add image
              </div>

            {% endif %}


            {% if block.settings.product != blank %}

              <button
                type="button"
                class="tv-product-grid__hotspot"
                style="
                  --hotspot-x: {{ block.settings.hotspot_x }}%;
                  --hotspot-y: {{ block.settings.hotspot_y }}%;
                "
                aria-label="View {{ block.settings.product.title }}"
                data-product-url="{{ block.settings.product.url }}"
              >

                <span class="tv-product-grid__hotspot-circle">
                  <span class="tv-product-grid__hotspot-plus"></span>
                </span>

              </button>

            {% endif %}

          </div>

        </article>

      {% endfor %}

    </div>

  </section>

</div>
